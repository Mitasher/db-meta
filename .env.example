# meta-db (PostgreSQL)
META_DB_NAME=meta
META_DB_USER=meta
META_DB_PASSWORD=change_me

# source-db (MySQL)
SOURCE_DB_NAME=casting
SOURCE_DB_USER=casting
SOURCE_DB_PASSWORD=change_me
SOURCE_DB_ROOT_PASSWORD=change_me_root

# Ключ шифрования паролей источников в meta-db
META_SECRET_KEY=

# Пользователь SQL-консоли в source-db: только SELECT/INSERT/UPDATE/DELETE, без DDL
SOURCE_DB_CONSOLE_USER=casting_console
SOURCE_DB_CONSOLE_PASSWORD=change_me_console

# true — SQL-консоль работает, false — /api/sql/execute отвечает 403
SQL_CONSOLE_ENABLED=true
